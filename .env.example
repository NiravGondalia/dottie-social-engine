# =============================================================================
# MiloAgent — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env && nano .env
#
# All secrets live here. YAML configs hold non-secret settings only.
# =============================================================================

# ── Web Dashboard Auth (password min 6 characters) ────────
MILO_WEB_USER=admin
MILO_WEB_PASS=changeme

# ── Buzz / MCP machine token (not the dashboard login) ──
# MILO_AGENT_TOKEN=
# MILO_AGENT_BASE_URL=http://127.0.0.1:8420

# Dashboard port (auto-resolved if taken)
MILO_PORT=8420

# ── LLM Providers ───────────────────────────────────────
MILO_GROQ_API_KEY=
# MILO_GEMINI_API_KEY=
# MILO_ANTHROPIC_API_KEY=

# ── Reddit account slot 1 ───────────────────────────────
MILO_REDDIT_USERNAME=
MILO_REDDIT_PASSWORD=
# Or indexed:
# MILO_REDDIT_1_USERNAME=
# MILO_REDDIT_1_PASSWORD=
# MILO_REDDIT_1_CLIENT_ID=
# MILO_REDDIT_1_CLIENT_SECRET=

# Reddit OAuth app (optional — for API auth mode)
# MILO_REDDIT_API_CLIENT_ID=
# MILO_REDDIT_API_CLIENT_SECRET=
# MILO_REDDIT_API_REDIRECT_URI=http://localhost:8420/api/reddit/oauth/callback

# ── Twitter (optional) ──────────────────────────────────
# MILO_TWITTER_USERNAME=
# MILO_TWITTER_PASSWORD=
# MILO_TWITTER_EMAIL=

# ── Telegram (optional) ─────────────────────────────────
# MILO_TELEGRAM_BOT_TOKEN=
# MILO_TELEGRAM_ADMIN_CHAT_ID=

# ── Timezone ────────────────────────────────────────────
TZ=UTC

# ── Dottie API (future — unused this phase; local stub + JSON export) ──
# DOTTIE_API_URL=https://api.dottie.app

# ── Docker resource limits ──────────────────────────────
MILO_MEM_LIMIT=512m
MILO_CPU_LIMIT=1.0
